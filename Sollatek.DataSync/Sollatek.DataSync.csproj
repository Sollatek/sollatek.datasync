<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
         <Nullable>disable</Nullable>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <ApplicationIcon>favicon.ico</ApplicationIcon>
        <UserSecretsId>Sollatek_datasync</UserSecretsId>
        <DataSyncProvider Condition="'$(DataSyncProvider)' == ''">all</DataSyncProvider>
        <DataSyncMonitoringProvider Condition="'$(DataSyncMonitoringProvider)' == ''">none</DataSyncMonitoringProvider>
        <IsDataSyncSqlProvider Condition="'$(DataSyncProvider)' == 'all' Or '$(DataSyncProvider)' == 'sql' Or '$(DataSyncProvider)' == 'sqlserver' Or '$(DataSyncProvider)' == 'mssql' Or '$(DataSyncProvider)' == 'postgres' Or '$(DataSyncProvider)' == 'mysql'">true</IsDataSyncSqlProvider>
        <IsDataSyncMongoProvider Condition="'$(DataSyncProvider)' == 'all' Or '$(DataSyncProvider)' == 'mongo' Or '$(DataSyncProvider)' == 'mongodb'">true</IsDataSyncMongoProvider>
        <IsDataSyncFilesystemProvider Condition="'$(DataSyncProvider)' == 'all' Or '$(DataSyncProvider)' == 'filesystem' Or '$(DataSyncProvider)' == 'files'">true</IsDataSyncFilesystemProvider>
        <IsDataSyncAzureBlobProvider Condition="'$(DataSyncProvider)' == 'all' Or '$(DataSyncProvider)' == 'azureblob' Or '$(DataSyncProvider)' == 'azureblobstorage' Or '$(DataSyncProvider)' == 'blob'">true</IsDataSyncAzureBlobProvider>
        <IsDataSyncMonitoringNone Condition="'$(DataSyncMonitoringProvider)' == 'none'">true</IsDataSyncMonitoringNone>
        <IsDataSyncMonitoringOtlp Condition="'$(DataSyncMonitoringProvider)' == 'all' Or '$(DataSyncMonitoringProvider)' == 'otlp' Or '$(DataSyncMonitoringProvider)' == 'opentelemetry' Or '$(DataSyncMonitoringProvider)' == 'otlp-status' Or '$(DataSyncMonitoringProvider)' == 'otlp-azuremonitor' Or '$(DataSyncMonitoringProvider)' == 'otlp-azuremonitor-status'">true</IsDataSyncMonitoringOtlp>
        <IsDataSyncMonitoringAzureMonitor Condition="'$(DataSyncMonitoringProvider)' == 'all' Or '$(DataSyncMonitoringProvider)' == 'azuremonitor' Or '$(DataSyncMonitoringProvider)' == 'azure' Or '$(DataSyncMonitoringProvider)' == 'appinsights' Or '$(DataSyncMonitoringProvider)' == 'applicationinsights' Or '$(DataSyncMonitoringProvider)' == 'azuremonitor-status' Or '$(DataSyncMonitoringProvider)' == 'otlp-azuremonitor' Or '$(DataSyncMonitoringProvider)' == 'otlp-azuremonitor-status'">true</IsDataSyncMonitoringAzureMonitor>
        <IsDataSyncMonitoringStatusEndpoint Condition="'$(DataSyncMonitoringProvider)' == 'all' Or '$(DataSyncMonitoringProvider)' == 'status' Or '$(DataSyncMonitoringProvider)' == 'statusendpoint' Or '$(DataSyncMonitoringProvider)' == 'http' Or '$(DataSyncMonitoringProvider)' == 'otlp-status' Or '$(DataSyncMonitoringProvider)' == 'azuremonitor-status' Or '$(DataSyncMonitoringProvider)' == 'otlp-azuremonitor-status'">true</IsDataSyncMonitoringStatusEndpoint>
        <DefineConstants Condition="'$(IsDataSyncSqlProvider)' == 'true'">$(DefineConstants);DATASYNC_PROVIDER_SQL</DefineConstants>
        <DefineConstants Condition="'$(IsDataSyncMongoProvider)' == 'true'">$(DefineConstants);DATASYNC_PROVIDER_MONGO</DefineConstants>
        <DefineConstants Condition="'$(IsDataSyncFilesystemProvider)' == 'true'">$(DefineConstants);DATASYNC_PROVIDER_FILESYSTEM</DefineConstants>
        <DefineConstants Condition="'$(IsDataSyncAzureBlobProvider)' == 'true'">$(DefineConstants);DATASYNC_PROVIDER_AZUREBLOB</DefineConstants>
        <DefineConstants Condition="'$(IsDataSyncMonitoringOtlp)' == 'true'">$(DefineConstants);DATASYNC_MONITORING_OTLP</DefineConstants>
        <DefineConstants Condition="'$(IsDataSyncMonitoringAzureMonitor)' == 'true'">$(DefineConstants);DATASYNC_MONITORING_AZUREMONITOR</DefineConstants>
        <DefineConstants Condition="'$(IsDataSyncMonitoringStatusEndpoint)' == 'true'">$(DefineConstants);DATASYNC_MONITORING_STATUSENDPOINT</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.9" />
      <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
      <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.9" />
      <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.9" />
      <PackageReference Include="Parquet.Net" Version="6.0.3" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Sollatek.DataSync.Abstractions\Sollatek.DataSync.Abstractions.csproj" />
      <ProjectReference Include="..\Sollatek.DataSync.Export\Sollatek.DataSync.Export.csproj" />
      <ProjectReference Include="..\Platform.ApiClient\Platform.ApiClient.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(IsDataSyncFilesystemProvider)' == 'true'">
      <ProjectReference Include="..\Stores\Sollatek.DataSync.Filesystem\Sollatek.DataSync.Filesystem.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(IsDataSyncAzureBlobProvider)' == 'true'">
      <ProjectReference Include="..\Stores\Sollatek.DataSync.AzureBlob\Sollatek.DataSync.AzureBlob.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(IsDataSyncMongoProvider)' == 'true'">
      <ProjectReference Include="..\Stores\Sollatek.DataSync.Mongo\Sollatek.DataSync.Mongo.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(IsDataSyncSqlProvider)' == 'true'">
      <ProjectReference Include="..\Stores\Sollatek.DataSync.Sql\Sollatek.DataSync.Sql.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(IsDataSyncMonitoringOtlp)' == 'true'">
      <ProjectReference Include="..\Monitoring\Sollatek.DataSync.Monitoring.Otlp\Sollatek.DataSync.Monitoring.Otlp.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(IsDataSyncMonitoringAzureMonitor)' == 'true'">
      <ProjectReference Include="..\Monitoring\Sollatek.DataSync.Monitoring.AzureMonitor\Sollatek.DataSync.Monitoring.AzureMonitor.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(IsDataSyncMonitoringStatusEndpoint)' == 'true'">
      <ProjectReference Include="..\Monitoring\Sollatek.DataSync.Monitoring.StatusEndpoint\Sollatek.DataSync.Monitoring.StatusEndpoint.csproj" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="appsettings.json" />
      <Content Include="appsettings.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <None Remove="appsettings.Development.json" />
      <Content Include="appsettings.Development.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

    <Target Name="ValidateDataSyncProvider" BeforeTargets="Restore;PrepareForBuild">
      <Error
        Condition="'$(IsDataSyncSqlProvider)' != 'true' And '$(IsDataSyncMongoProvider)' != 'true' And '$(IsDataSyncFilesystemProvider)' != 'true' And '$(IsDataSyncAzureBlobProvider)' != 'true'"
        Text="DataSyncProvider must be one of: all, sql, sqlserver, mssql, postgres, mysql, mongo, mongodb, filesystem, files, azureblob, azureblobstorage, blob." />
      <Error
        Condition="'$(IsDataSyncMonitoringNone)' != 'true' And '$(IsDataSyncMonitoringOtlp)' != 'true' And '$(IsDataSyncMonitoringAzureMonitor)' != 'true' And '$(IsDataSyncMonitoringStatusEndpoint)' != 'true'"
        Text="DataSyncMonitoringProvider must be one of: none, all, otlp, opentelemetry, azuremonitor, azure, appinsights, applicationinsights, status, statusendpoint, http, otlp-status, azuremonitor-status, otlp-azuremonitor, otlp-azuremonitor-status." />
    </Target>

</Project>
