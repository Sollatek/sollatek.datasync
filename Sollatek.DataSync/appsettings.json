{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "SyncPlan": [
    {
      "customers": {
        "initial": "full"
      }
    },
    {
      "devices": {
        "initial": "full"
      }
    },
    {
      "pointsOfInterest": {
        "initial": "full"
      }
    },
    {
      "assets": {
        "initial": "full"
      }
    },
    {
      "rawDataLocationdata": {
        "initial": "full"
      }
    },
    {
      "rawDataExtrainfodata": {
        "initial": "full"
      }
    },
    {
      "rawDataTemperaturedata": {
        "initial": "full"
      }
    },
    {
      "rawDataDooropeningdata": {
        "initial": "full"
      }
    }
  ],
  "Sync": {
    "runOnStartup": true,
    "stopWhenFinished": false,
    "runInterval": "06:00:00",
    "maxPageSize": 500,
    "startFrom": null
  },
  "Retry": {
    "maxTries": 3,
    "period": "00:05:00",
    "delayFunction": "linear"
  },
  "Monitoring": {
    "enabled": true,
    "serviceName": "sollatek-datasync",
    "metricsEnabled": true,
    "structuredLogsEnabled": true,
    "otlp": {
      "enabled": false,
      "metricsEnabled": true,
      "logsEnabled": false,
      "endpoint": null,
      "metricsEndpoint": null,
      "logsEndpoint": null,
      "protocol": "grpc",
      "exportInterval": "00:01:00",
      "timeout": "00:00:10"
    },
    "azureMonitor": {
      "enabled": false,
      "metricsEnabled": true,
      "logsEnabled": false,
      "connectionString": null
    },
    "statusEndpoint": {
      "enabled": false,
      "url": "http://127.0.0.1:5055",
      "statusPath": "/status",
      "healthPath": "/health"
    }
  },
  "Storage": {
    "provider": "sqlserver",
    "connectionString": null,
    "schemaMode": "validate"
  },
  "FileExport": {
    "rootPath": ".artifacts/exports",
    "format": "parquet"
  },
  "SwaggerDocuments": [
    {
      "name": "data-v1",
      "url": "https://api.sollatek.io/swagger/data-v1/swagger.json"
    },
    {
      "name": "portal-v1",
      "url": "https://api.sollatek.io/swagger/portal-v1/swagger.json"
    }
  ],
  "Settings": {
    "oauthUrl": "https://id.sollatek.io/",
    "apiUrl": "https://api.sollatek.io/"
  }
}
